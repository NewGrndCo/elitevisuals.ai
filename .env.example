# Browser-safe Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — use a restricted key where supported
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional transactional email webhook
PURCHASE_EMAIL_WEBHOOK_SECRET=
RESEND_API_KEY=

# Server-only CMS credentials. No hard-coded defaults. Use a strong PIN/passphrase.
ADMIN_PIN=

ADMIN_SESSION_SECRET=
# NEXT_PUBLIC aliases are supported for the two browser-safe Supabase settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://elitevisualsai.netlify.app
